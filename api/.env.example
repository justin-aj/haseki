DATABASE_URL=postgres://haseki:haseki@localhost:5433/haseki
BIND_ADDR=127.0.0.1:8080
RUST_LOG=haseki_api=debug,tower_http=info
SITE_URL=http://localhost:3000
SECURE_COOKIES=false

# `providers` calls Razorpay/Stripe. `mock` marks orders paid instantly, for local development
# only; the API refuses to start in mock mode with an https SITE_URL or SECURE_COOKIES=true.
PAYMENTS_MODE=providers
# Razorpay (INR): https://dashboard.razorpay.com/app/keys (use test keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Stripe (USD, GBP, AED): https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Shared secret for the storefront's /revalidate route (set the same value in web/.env.local).
REVALIDATE_SECRET=

# Order emails via Resend. Without a key, emails are logged instead of sent.
RESEND_API_KEY=
EMAIL_FROM=Haseki <orders@haseki.in>

# Preview deployments only: allow PAYMENTS_MODE=mock behind https. Never in production.
# ALLOW_MOCK_PAYMENTS_ON_HTTPS=true
